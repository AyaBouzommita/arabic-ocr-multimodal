{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DetectionOutput",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "enum": ["yolov8", "detectron2", "florence2"]
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": ["Stamp", "Logo", "Signature", "Header", "Table", "Date", "InstitutionName"]
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            },
            "description": "Bounding box coordinates [x1, y1, x2, y2]"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "context_tag": {
            "type": "string",
            "enum": ["administrative", "financial", "none"]
          }
        },
        "required": ["label", "bbox", "confidence", "context_tag"]
      }
    }
  },
  "required": ["document_id", "model", "objects"]
}

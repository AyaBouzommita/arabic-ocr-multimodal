{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCROutput",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique identifier of the document"
    },
    "engine": {
      "type": "string",
      "enum": ["tesseract", "easyocr", "paddleocr"],
      "description": "The OCR engine that produced the result"
    },
    "raw_text": {
      "type": "string",
      "description": "Full extracted text"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            },
            "description": "Bounding box coordinates [x1, y1, x2, y2]"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["text", "bbox", "confidence"]
      }
    },
    "processing_time_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["document_id", "engine", "raw_text", "tokens", "processing_time_ms"]
}

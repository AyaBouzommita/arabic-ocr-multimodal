{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FusionInput",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "ocr": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string" },
        "engine": { "type": "string", "enum": ["tesseract", "easyocr", "paddleocr"] },
        "raw_text": { "type": "string" },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "bbox": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "number" }
              },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            },
            "required": ["text", "bbox", "confidence"]
          }
        },
        "processing_time_ms": { "type": "integer", "minimum": 0 }
      },
      "required": ["document_id", "engine", "raw_text", "tokens", "processing_time_ms"]
    },
    "detected_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": ["Stamp", "Logo", "Signature", "Header", "Table", "Date", "InstitutionName"]
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "context_tag": { "type": "string", "enum": ["administrative", "financial", "none"] }
        },
        "required": ["label", "bbox", "confidence", "context_tag"]
      }
    },
    "correction_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original_word": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 },
            "description": "[start_idx, end_idx]"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "lm_score": { "type": "number" }
              },
              "required": ["text", "lm_score"]
            }
          }
        },
        "required": ["original_word", "position", "candidates"]
      }
    }
  },
  "required": ["document_id", "ocr", "detected_objects", "correction_candidates"]
}
